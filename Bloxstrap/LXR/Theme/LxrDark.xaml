<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- LXRStrap dark palette: true black, white glass, monochrome. The accent can be changed in Settings. -->

    <SolidColorBrush x:Key="LxrWindowFallbackBrush" Color="#FF000000" />

    <LinearGradientBrush x:Key="LxrWindowTintBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6000000" Offset="0" />
        <GradientStop Color="#F2050507" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="LxrGlowABrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#22FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="LxrGlowBBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#14FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="LxrSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#14FFFFFF" Offset="0" />
        <GradientStop Color="#08FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LxrSurfaceHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#24FFFFFF" Offset="0" />
        <GradientStop Color="#10FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LxrSidebarBrush" Color="#66000000" />
    <SolidColorBrush x:Key="LxrInputBrush" Color="#66000000" />
    <SolidColorBrush x:Key="LxrHoverOverlayBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="LxrPressOverlayBrush" Color="#18000000" />

    <LinearGradientBrush x:Key="LxrBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#40FFFFFF" Offset="0" />
        <GradientStop Color="#0DFFFFFF" Offset="0.5" />
        <GradientStop Color="#22FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- bright edge that fades in on hover -->
    <LinearGradientBrush x:Key="LxrRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#99FFFFFF" Offset="0" />
        <GradientStop Color="#26FFFFFF" Offset="0.55" />
        <GradientStop Color="#66FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LxrBorderSoftBrush" Color="#1AFFFFFF" />
    <LinearGradientBrush x:Key="LxrTopHighlightBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#44FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="LxrTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="LxrTextDimBrush" Color="#FFB8B8BE" />
    <SolidColorBrush x:Key="LxrTextFaintBrush" Color="#FF77777F" />

    <LinearGradientBrush x:Key="LxrAccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#FFC9C9D2" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LxrAccentSolidBrush" Color="#FFFFFFFF" />
    <Color x:Key="LxrAccentColor">#FFFFFFFF</Color>
    <RadialGradientBrush x:Key="LxrAccentGlowBrush">
        <GradientStop Color="#55FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="LxrAccentAuraBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#3DFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="LxrAccentFaintBrush" Color="#18FFFFFF" />
    <LinearGradientBrush x:Key="LxrAccentLineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LxrAccentSoftBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="LxrOnAccentBrush" Color="#FF000000" />

    <SolidColorBrush x:Key="LxrDangerBrush" Color="#FFFF6B7A" />
    <SolidColorBrush x:Key="LxrDangerSoftBrush" Color="#33FF6B7A" />
    <SolidColorBrush x:Key="LxrSuccessBrush" Color="#FF63E6B4" />
    <SolidColorBrush x:Key="LxrSuccessSoftBrush" Color="#3363E6B4" />
    <SolidColorBrush x:Key="LxrWarnBrush" Color="#FFFFC66B" />
    <SolidColorBrush x:Key="LxrWarnSoftBrush" Color="#33FFC66B" />

    <SolidColorBrush x:Key="LxrToggleOffBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="LxrToggleKnobBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="LxrPopupBrush" Color="#FF0D0D10" />
    <SolidColorBrush x:Key="LxrPopupBorderBrush" Color="#33FFFFFF" />
    <Color x:Key="LxrSpotColor">#30FFFFFF</Color>
    <SolidColorBrush x:Key="LxrScrimBrush" Color="#B3000000" />
</ResourceDictionary>
