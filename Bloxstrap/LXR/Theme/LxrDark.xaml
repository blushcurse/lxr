<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- LXRStrap dark palette: deep indigo base, soft violet/aqua accents -->

    <LinearGradientBrush x:Key="LxrWindowFallbackBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0B0D1C" Offset="0" />
        <GradientStop Color="#FF12152B" Offset="0.55" />
        <GradientStop Color="#FF0E1022" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LxrWindowTintBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D90B0D1C" Offset="0" />
        <GradientStop Color="#CC12152B" Offset="0.55" />
        <GradientStop Color="#D90E1022" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="LxrGlowABrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#557C8CFF" Offset="0" />
        <GradientStop Color="#007C8CFF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="LxrGlowBBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#3A5EE7DF" Offset="0" />
        <GradientStop Color="#005EE7DF" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="LxrSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1CFFFFFF" Offset="0" />
        <GradientStop Color="#0AFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LxrSurfaceHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2CFFFFFF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LxrSidebarBrush" Color="#33080A16" />
    <SolidColorBrush x:Key="LxrInputBrush" Color="#33000000" />
    <SolidColorBrush x:Key="LxrHoverOverlayBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="LxrPressOverlayBrush" Color="#10000000" />

    <LinearGradientBrush x:Key="LxrBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#48FFFFFF" Offset="0" />
        <GradientStop Color="#12FFFFFF" Offset="0.5" />
        <GradientStop Color="#26FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LxrBorderSoftBrush" Color="#1FFFFFFF" />
    <LinearGradientBrush x:Key="LxrTopHighlightBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#55FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="LxrTextBrush" Color="#F2F4FF" />
    <SolidColorBrush x:Key="LxrTextDimBrush" Color="#B4B9D6" />
    <SolidColorBrush x:Key="LxrTextFaintBrush" Color="#7C82A3" />

    <LinearGradientBrush x:Key="LxrAccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF8F7CFF" Offset="0" />
        <GradientStop Color="#FF4FB4FF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LxrAccentSolidBrush" Color="#FF8F9BFF" />
    <SolidColorBrush x:Key="LxrAccentSoftBrush" Color="#338F9BFF" />
    <SolidColorBrush x:Key="LxrOnAccentBrush" Color="#FF0B0D1C" />

    <SolidColorBrush x:Key="LxrDangerBrush" Color="#FFFF7B8A" />
    <SolidColorBrush x:Key="LxrDangerSoftBrush" Color="#33FF7B8A" />
    <SolidColorBrush x:Key="LxrSuccessBrush" Color="#FF5EE7B0" />
    <SolidColorBrush x:Key="LxrSuccessSoftBrush" Color="#335EE7B0" />
    <SolidColorBrush x:Key="LxrWarnBrush" Color="#FFFFC66B" />
    <SolidColorBrush x:Key="LxrWarnSoftBrush" Color="#33FFC66B" />

    <SolidColorBrush x:Key="LxrToggleOffBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="LxrToggleKnobBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="LxrPopupBrush" Color="#FF171A30" />
    <SolidColorBrush x:Key="LxrPopupBorderBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="LxrScrimBrush" Color="#99000000" />
</ResourceDictionary>
