<local:LxrWindow x:Class="Bloxstrap.LXR.UI.LaunchWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:Bloxstrap.LXR.UI"
                 Title="LXRStrap" Width="520" Height="300" ResizeMode="NoResize"
                 Closing="Window_Closing">

    <Grid Margin="36,8,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="52" Height="52" CornerRadius="16" Background="{DynamicResource LxrAccentBrush}">
                <TextBlock Text="LXR" FontFamily="{StaticResource LxrDisplayFont}" FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource LxrOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="LXRStrap" Style="{StaticResource LxrTitle}" FontSize="22" />
                <TextBlock Text="Getting Roblox ready" Style="{StaticResource LxrFaint}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Message}" Style="{StaticResource LxrBody}" FontSize="14" TextTrimming="CharacterEllipsis" />
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar IsIndeterminate="{Binding Indeterminate}" Maximum="{Binding Maximum}" Value="{Binding Value}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding PercentText}" Style="{StaticResource LxrFaint}" Margin="14,0,0,0" MinWidth="34" TextAlignment="Right" />
            </Grid>
        </StackPanel>

        <Button x:Name="CancelButton" Grid.Row="2" Content="Cancel" HorizontalAlignment="Right"
                Visibility="{Binding CancelVisibility}" Click="CancelButton_Click" />
    </Grid>
</local:LxrWindow>
