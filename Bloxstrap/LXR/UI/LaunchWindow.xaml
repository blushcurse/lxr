<local:LxrWindow x:Class="Bloxstrap.LXR.UI.LaunchWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:Bloxstrap.LXR.UI"
                 Title="LXRStrap" Width="440" Height="460" ResizeMode="NoResize"
                 Closing="Window_Closing">
    <Grid Margin="40,4,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <local:LiquidOrb Width="150" Height="188" HorizontalAlignment="Center" VerticalAlignment="Center" />

        <StackPanel Grid.Row="1" Margin="0,6,0,0">
            <TextBlock Text="LXRStrap" Style="{StaticResource LxrTitle}" FontSize="22" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource LxrDim}" FontSize="13" Margin="0,8,0,0"
                       HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" />
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar IsIndeterminate="{Binding Indeterminate}" Maximum="{Binding Maximum}" Value="{Binding Value}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding PercentText}" Style="{StaticResource LxrFaint}" Margin="14,0,0,0" MinWidth="34" TextAlignment="Right" />
            </Grid>
        </StackPanel>

        <Button x:Name="CancelButton" Grid.Row="2" Content="Cancel" HorizontalAlignment="Center" Margin="0,18,0,0"
                Visibility="{Binding CancelVisibility}" Click="CancelButton_Click" />
    </Grid>
</local:LxrWindow>
