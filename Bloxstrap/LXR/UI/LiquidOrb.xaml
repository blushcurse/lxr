<UserControl x:Class="Bloxstrap.LXR.UI.LiquidOrb"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" SnapsToDevicePixels="False">
    <UserControl.Resources>
        <Storyboard x:Key="Flow">
            <DoubleAnimation Storyboard.TargetName="B1" Storyboard.TargetProperty="X" From="-30" To="45" Duration="0:0:7.3" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="B1" Storyboard.TargetProperty="Y" From="20" To="-35" Duration="0:0:5.9" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="B2" Storyboard.TargetProperty="X" From="40" To="-40" Duration="0:0:8.7" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="B2" Storyboard.TargetProperty="Y" From="-25" To="35" Duration="0:0:6.7" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="D1" Storyboard.TargetProperty="X" From="-45" To="30" Duration="0:0:6.1" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="D1" Storyboard.TargetProperty="Y" From="-30" To="40" Duration="0:0:9.1" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="D2" Storyboard.TargetProperty="X" From="35" To="-35" Duration="0:0:7.9" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="D2" Storyboard.TargetProperty="Y" From="30" To="-30" Duration="0:0:5.3" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- the drip: forms, stretches, falls and fades -->
            <DoubleAnimation Storyboard.TargetName="DripMove" Storyboard.TargetProperty="Y" From="0" To="30" Duration="0:0:3.4" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DripScale" Storyboard.TargetProperty="ScaleY" From="0.35" To="1.15" Duration="0:0:3.4" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="DripScale" Storyboard.TargetProperty="ScaleX" From="0.35" To="0.9" Duration="0:0:3.4" RepeatBehavior="Forever" />
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Drip" Storyboard.TargetProperty="Opacity" Duration="0:0:3.4" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="0.95" />
                <LinearDoubleKeyFrame KeyTime="0:0:2.6" Value="0.95" />
                <LinearDoubleKeyFrame KeyTime="0:0:3.4" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Canvas Width="200" Height="250">
            <!-- sphere body -->
            <Ellipse Canvas.Left="0" Canvas.Top="0" Width="200" Height="200">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.38,0.3" RadiusX="0.75" RadiusY="0.75">
                        <GradientStop Color="#FFF4F4F7" Offset="0" />
                        <GradientStop Color="#FF8B8B96" Offset="0.45" />
                        <GradientStop Color="#FF0B0B0E" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- liquid: drifting light and dark masses clipped to the sphere -->
            <Canvas Width="200" Height="200" ClipToBounds="True">
                <Canvas.Clip>
                    <EllipseGeometry Center="100,100" RadiusX="99" RadiusY="99" />
                </Canvas.Clip>

                <Ellipse Canvas.Left="20" Canvas.Top="30" Width="120" Height="120">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#EEFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="B1" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="70" Canvas.Top="80" Width="110" Height="110">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#B3FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="B2" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="-10" Canvas.Top="70" Width="130" Height="130">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#F2000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="D1" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="80" Canvas.Top="-5" Width="110" Height="110">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#D9000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="D2" /></Ellipse.RenderTransform>
                </Ellipse>

                <!-- glass highlight -->
                <Ellipse Canvas.Left="34" Canvas.Top="14" Width="90" Height="46">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#88FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <!-- glass rim -->
            <Ellipse Canvas.Left="0.75" Canvas.Top="0.75" Width="198.5" Height="198.5" StrokeThickness="1.5">
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#CCFFFFFF" Offset="0" />
                        <GradientStop Color="#22FFFFFF" Offset="0.5" />
                        <GradientStop Color="#66FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Stroke>
            </Ellipse>

            <!-- drip -->
            <Canvas x:Name="Drip" Canvas.Left="100" Canvas.Top="196" Opacity="0">
                <Path Fill="#F2FFFFFF" Data="M0,-4 C 5,6 9,12 9,18 A9,9 0 1 1 -9,18 C -9,12 -5,6 0,-4 Z">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="DripScale" ScaleX="0.35" ScaleY="0.35" />
                            <TranslateTransform x:Name="DripMove" />
                        </TransformGroup>
                    </Path.RenderTransform>
                </Path>
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
