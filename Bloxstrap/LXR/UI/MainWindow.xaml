<local:LxrWindow x:Class="Bloxstrap.LXR.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:Bloxstrap.LXR.UI"
                 Title="LXRStrap" Width="1120" Height="740" MinWidth="900" MinHeight="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- top bar: brand left, floating glass dock centre, save state right -->
        <Grid Margin="24,6,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <local:LiquidOrb Width="28" Height="35" Animated="False" ShowDrip="False" />
                <TextBlock Text="LXRStrap" Style="{StaticResource LxrHeading}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <Border Grid.Column="1" CornerRadius="26" Padding="5" Background="{DynamicResource LxrSurfaceBrush}"
                    BorderBrush="{DynamicResource LxrBorderBrush}" BorderThickness="1">
                <Grid x:Name="DockHost">
                    <Border x:Name="DockIndicator" HorizontalAlignment="Left" Width="0" CornerRadius="21"
                            Background="{DynamicResource LxrSurfaceHoverBrush}" BorderBrush="{DynamicResource LxrRimBrush}" BorderThickness="1">
                        <Border.RenderTransform><TranslateTransform x:Name="DockShift" X="0" /></Border.RenderTransform>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="NavHome" Content="Home" Tag="&#xE80F;" Style="{StaticResource LxrDockItem}" Checked="Nav_Checked" GroupName="nav" IsChecked="True" />
                        <RadioButton x:Name="NavFlags" Content="FastFlags" Tag="&#xE7C1;" Style="{StaticResource LxrDockItem}" Checked="Nav_Checked" GroupName="nav" />
                        <RadioButton x:Name="NavCustom" Content="Customize" Tag="&#xE790;" Style="{StaticResource LxrDockItem}" Checked="Nav_Checked" GroupName="nav" />
                        <RadioButton x:Name="NavUpdates" Content="Updates" Tag="&#xE895;" Style="{StaticResource LxrDockItem}" Checked="Nav_Checked" GroupName="nav" />
                        <RadioButton x:Name="NavSettings" Content="Settings" Tag="&#xE713;" Style="{StaticResource LxrDockItem}" Checked="Nav_Checked" GroupName="nav" />
                        <RadioButton x:Name="NavAbout" Content="About" Tag="&#xE946;" Style="{StaticResource LxrDockItem}" Checked="Nav_Checked" GroupName="nav" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource LxrSuccessBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="SaveText" Text="All changes saved" Style="{StaticResource LxrFaint}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <ContentControl x:Name="PageHost" Grid.Row="1" IsTabStop="False" />
    </Grid>
</local:LxrWindow>
