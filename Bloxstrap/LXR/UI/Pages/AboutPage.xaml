<UserControl x:Class="Bloxstrap.LXR.UI.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Bloxstrap.LXR.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,20,40,32" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <ui:LiquidOrb Width="80" Height="100" />
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="LXRStrap" Style="{StaticResource LxrTitle}" FontSize="28" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource LxrDim}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Style="{StaticResource LxrBody}" TextWrapping="Wrap" LineHeight="20" Margin="0,22,0,0"
                       Text="A lightweight Roblox launcher with a FastFlags explorer, cursor and mod management, and a redesigned interface. It starts Roblox, applies your settings, and gets out of the way." />

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Content="Project on GitHub" Click="Repo_Click" Style="{StaticResource LxrPrimaryButton}" />
                <Button Content="Report an issue" Margin="8,0,0,0" Click="Issue_Click" />
                <Button Content="Copy diagnostics" Margin="8,0,0,0" Click="Copy_Click" />
            </StackPanel>

            <TextBlock Text="Credits and licence" Style="{StaticResource LxrHeading}" Margin="0,34,0,8" />
            <ContentControl Style="{StaticResource LxrCard}">
                <StackPanel Margin="22,18">
                    <TextBlock Style="{StaticResource LxrBody}" TextWrapping="Wrap" LineHeight="20"
                               Text="LXRStrap is a modified version of Bloxstrap, created by pizzaboxer and contributors and released under the MIT licence. The original copyright and licence notice are kept in the LICENSE file shipped with the source." />
                    <TextBlock Style="{StaticResource LxrBody}" TextWrapping="Wrap" LineHeight="20" Margin="0,12,0,0">
                        <Hyperlink NavigateUri="https://github.com/bloxstraplabs/bloxstrap" RequestNavigate="Link_Navigate">Original Bloxstrap project</Hyperlink>
                    </TextBlock>
                    <TextBlock Style="{StaticResource LxrFaint}" TextWrapping="Wrap" LineHeight="18" Margin="0,16,0,0"
                               Text="LXRStrap is not affiliated with, endorsed by, or sponsored by Roblox Corporation or the Bloxstrap project. Roblox is a trademark of Roblox Corporation. LXRStrap never modifies Roblox's executables or bypasses its protections; it only places files and FastFlag settings in the locations Roblox reads at launch." />
                </StackPanel>
            </ContentControl>

            <TextBlock Text="Built with" Style="{StaticResource LxrHeading}" Margin="0,26,0,8" />
            <TextBlock Style="{StaticResource LxrDim}" TextWrapping="Wrap" LineHeight="20"
                       Text="CommunityToolkit.Mvvm, Markdig, AvalonEdit, DiscordRichPresence, SharpZipLib, Microsoft.Windows.CsWin32 and WPF UI (tray menus only). Each is used under its own open-source licence." />

            <TextBlock Text="Folders" Style="{StaticResource LxrHeading}" Margin="0,26,0,8" />
            <TextBlock x:Name="PathsText" Style="{StaticResource LxrFaint}" FontFamily="Consolas" TextWrapping="Wrap" LineHeight="18" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
