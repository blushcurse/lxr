<UserControl x:Class="Bloxstrap.LXR.UI.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Bloxstrap.LXR.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="44,18,44,32" MaxWidth="1040">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- hero -->
            <ContentControl Style="{StaticResource LxrCard}" Grid.RowSpan="2">
                <Grid>
                    <Ellipse Width="460" Height="460" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"
                             Fill="{DynamicResource LxrAccentAuraBrush}" IsHitTestVisible="False" />
                    <Grid Margin="36,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="SubText" Style="{StaticResource LxrFaint}" />
                        <TextBlock Text="Ready when you are" Style="{StaticResource LxrTitle}" FontSize="34" Margin="0,6,0,0" />
                        <Rectangle Style="{StaticResource LxrAccentRule}" Width="96" Height="4" Margin="0,12,0,0" />
                    </StackPanel>

                    <ui:LiquidOrb Grid.Row="1" Width="190" Height="238" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,18" />

                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="LaunchHint" Style="{StaticResource LxrDim}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                                   Text="Checks for an update, applies your FastFlags, cursors and mods, then starts the game." />
                        <Border x:Name="RunningNote" Style="{StaticResource LxrChip}" Margin="0,12,0,0" HorizontalAlignment="Center"
                                Background="{DynamicResource LxrWarnSoftBrush}" Visibility="Collapsed">
                            <TextBlock Foreground="{DynamicResource LxrWarnBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                       Text="Roblox is running. Changes apply the next time it starts." />
                        </Border>
                        <Button Content="Play" Style="{StaticResource LxrHeroButton}" Click="Play_Click" HorizontalAlignment="Stretch" Margin="0,18,0,0" />
                        <Button Content="Open Roblox Studio" Margin="0,10,0,0" HorizontalAlignment="Center" Style="{StaticResource LxrGhostButton}" Click="Studio_Click" />
                    </StackPanel>
                    </Grid>
                </Grid>
            </ContentControl>

            <!-- side stack -->
            <StackPanel Grid.Column="2">
                <Button x:Name="UpdateBanner" Style="{StaticResource LxrCardButton}" Margin="0,0,0,12" Padding="18,14" Tag="updates"
                        Click="Tile_Click" Visibility="Collapsed">
                    <TextBlock x:Name="UpdateBannerText" Style="{StaticResource LxrBody}" TextWrapping="Wrap" />
                </Button>

                <Button Style="{StaticResource LxrCardButton}" Margin="0,0,0,12" Click="Tile_Click" Tag="flags">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource LxrAccentSoftBrush}" VerticalAlignment="Top" Margin="0,0,16,0">
                            <TextBlock Text="&#xE7C1;" Style="{StaticResource LxrIcon}" FontSize="20" Foreground="{DynamicResource LxrAccentSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="FastFlags" Style="{StaticResource LxrHeading}" />
                            <TextBlock x:Name="FlagsTileText" Style="{StaticResource LxrDim}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Style="{StaticResource LxrCardButton}" Margin="0,0,0,12" Click="Tile_Click" Tag="customization">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource LxrAccentSoftBrush}" VerticalAlignment="Top" Margin="0,0,16,0">
                            <TextBlock Text="&#xE790;" Style="{StaticResource LxrIcon}" FontSize="20" Foreground="{DynamicResource LxrAccentSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Customize" Style="{StaticResource LxrHeading}" />
                            <TextBlock x:Name="CustomTileText" Style="{StaticResource LxrDim}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Style="{StaticResource LxrCardButton}" Margin="0,0,0,12" Click="Tile_Click" Tag="updates">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource LxrAccentSoftBrush}" VerticalAlignment="Top" Margin="0,0,16,0">
                            <TextBlock Text="&#xE895;" Style="{StaticResource LxrIcon}" FontSize="20" Foreground="{DynamicResource LxrAccentSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Roblox updates" Style="{StaticResource LxrHeading}" />
                            <TextBlock x:Name="UpdatesTileText" Style="{StaticResource LxrDim}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Style="{StaticResource LxrCardButton}" Click="Tile_Click" Tag="settings">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource LxrAccentSoftBrush}" VerticalAlignment="Top" Margin="0,0,16,0">
                            <TextBlock Text="&#xE713;" Style="{StaticResource LxrIcon}" FontSize="20" Foreground="{DynamicResource LxrAccentSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Settings" Style="{StaticResource LxrHeading}" />
                            <TextBlock Text="Theme, accent, performance and privacy." Style="{StaticResource LxrDim}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
