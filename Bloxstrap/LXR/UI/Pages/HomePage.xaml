<UserControl x:Class="Bloxstrap.LXR.UI.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,20,40,32" MaxWidth="820" HorizontalAlignment="Stretch">
            <TextBlock Text="Ready when you are" Style="{StaticResource LxrTitle}" FontSize="30" />
            <TextBlock x:Name="SubText" Style="{StaticResource LxrDim}" Margin="0,6,0,0" />

            <ContentControl Style="{StaticResource LxrCard}" Margin="0,26,0,0">
                <Grid Margin="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Launch Roblox" Style="{StaticResource LxrHeading}" FontSize="20" />
                        <TextBlock x:Name="LaunchHint" Style="{StaticResource LxrDim}" TextWrapping="Wrap" Margin="0,6,24,0"
                                   Text="Checks for an update, applies your FastFlags, cursors and mods, then starts the game." />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Play" Style="{StaticResource LxrHeroButton}" Click="Play_Click" MinWidth="150" />
                </Grid>
            </ContentControl>

            <Border x:Name="RunningNote" Style="{StaticResource LxrChip}" Margin="0,14,0,0" HorizontalAlignment="Left"
                    Background="{DynamicResource LxrWarnSoftBrush}" Visibility="Collapsed">
                <TextBlock Foreground="{DynamicResource LxrWarnBrush}" FontSize="12" TextWrapping="Wrap"
                           Text="Roblox is running. FastFlag, cursor and mod changes apply the next time it starts." />
            </Border>

            <UniformGrid Columns="3" Margin="0,18,0,0">
                <Button Style="{StaticResource LxrCardButton}" Margin="0,0,7,0" Click="Tile_Click" Tag="flags">
                    <StackPanel>
                        <TextBlock Text="&#xE7C1;" Style="{StaticResource LxrIcon}" FontSize="20" Foreground="{DynamicResource LxrAccentSolidBrush}" HorizontalAlignment="Left" />
                        <TextBlock Text="FastFlags" Style="{StaticResource LxrHeading}" Margin="0,14,0,0" />
                        <TextBlock x:Name="FlagsTileText" Style="{StaticResource LxrDim}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource LxrCardButton}" Margin="7,0" Click="Tile_Click" Tag="customization">
                    <StackPanel>
                        <TextBlock Text="&#xE790;" Style="{StaticResource LxrIcon}" FontSize="20" Foreground="{DynamicResource LxrAccentSolidBrush}" HorizontalAlignment="Left" />
                        <TextBlock Text="Customization" Style="{StaticResource LxrHeading}" Margin="0,14,0,0" />
                        <TextBlock x:Name="CustomTileText" Style="{StaticResource LxrDim}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource LxrCardButton}" Margin="7,0,0,0" Click="Tile_Click" Tag="settings">
                    <StackPanel>
                        <TextBlock Text="&#xE713;" Style="{StaticResource LxrIcon}" FontSize="20" Foreground="{DynamicResource LxrAccentSolidBrush}" HorizontalAlignment="Left" />
                        <TextBlock Text="Settings" Style="{StaticResource LxrHeading}" Margin="0,14,0,0" />
                        <TextBlock Text="Theme, performance, privacy and updates." Style="{StaticResource LxrDim}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <Button Content="Open Roblox Studio" Margin="0,22,0,0" HorizontalAlignment="Left" Style="{StaticResource LxrGhostButton}" Click="Studio_Click" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
