<local:LxrWindow x:Class="Bloxstrap.LXR.UI.ProfilesWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:Bloxstrap.LXR.UI"
                 Title="FastFlag profiles" Width="520" Height="560" MinHeight="460">
    <Grid Margin="28,6,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Profiles" Style="{StaticResource LxrTitle}" FontSize="22" />
            <TextBlock Style="{StaticResource LxrDim}" TextWrapping="Wrap" Margin="0,6,0,14"
                       Text="Save your current FastFlags under a name, switch between setups in one click, or share a profile as a file. Applying a profile replaces your current flags." />
        </StackPanel>

        <ListBox x:Name="ProfileList" Grid.Row="1" Style="{StaticResource LxrListBox}" ItemContainerStyle="{StaticResource LxrListItem}"
                 SelectionChanged="ProfileList_SelectionChanged" />

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ApplyButton" Content="Apply" Style="{StaticResource LxrPrimaryButton}" IsEnabled="False" Click="Apply_Click" />
                <Button x:Name="ExportButton" Content="Export" Margin="8,0,0,0" IsEnabled="False" Click="Export_Click" />
                <Button x:Name="DeleteButton" Content="Delete" Margin="8,0,0,0" IsEnabled="False" Click="Delete_Click" Style="{StaticResource LxrGhostButton}" />
                <Button Content="Import file…" Margin="8,0,0,0" Click="Import_Click" Style="{StaticResource LxrGhostButton}" />
            </StackPanel>
            <TextBlock x:Name="Message" Style="{StaticResource LxrDim}" TextWrapping="Wrap" Margin="2,10,0,0" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NameBox" ToolTip="Name for the new profile" />
            <Button Grid.Column="1" Content="Save current flags" Margin="10,0,0,0" Click="Save_Click" />
        </Grid>
    </Grid>
</local:LxrWindow>
