<local:LxrWindow x:Class="Bloxstrap.LXR.UI.UninstallWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:Bloxstrap.LXR.UI"
                 Title="Uninstall LXRStrap" Width="500" SizeToContent="Height" ResizeMode="NoResize">
    <Grid Margin="28,6,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Remove LXRStrap?" Style="{StaticResource LxrTitle}" FontSize="22" Margin="0,0,0,10" />
        <TextBlock Grid.Row="1" x:Name="InfoText" Style="{StaticResource LxrDim}" Margin="0,0,0,16" />

        <local:OptionRow Grid.Row="2" Title="Keep my settings" Description="Keeps your FastFlags, cursors, mod packs and preferences so a reinstall picks up where you left off.">
            <CheckBox x:Name="KeepDataBox" IsChecked="True" />
        </local:OptionRow>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Margin="0,0,10,0" IsCancel="True" />
            <Button x:Name="ConfirmButton" Content="Uninstall" Style="{StaticResource LxrDangerButton}" MinWidth="104" />
        </StackPanel>
    </Grid>
</local:LxrWindow>
